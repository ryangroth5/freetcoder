# Copy to .env; docker compose substitutes these automatically.
#
# The API key lives here and nowhere else. It is deliberately not stored in the
# database: keeping the credential out of the app's own data means the settings
# API cannot be turned into an exfiltrator by repointing the endpoint, and
# nothing lands in plaintext on a mounted volume.
FREETCODER_LLM_API_KEY=

# Optional. Both also editable at runtime from the settings page, and a value
# saved there wins over these.
# FREETCODER_LLM_BASE_URL=https://openrouter.ai/api/v1
# FREETCODER_LLM_MODEL=anthropic/claude-sonnet-4.5
# A second model on the same endpoint, tried once if the first stalls or fails.
# FREETCODER_LLM_FALLBACK_MODEL=minimax/minimax-m2.7
